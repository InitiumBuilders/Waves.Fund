{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/now-lets-begin",
      "destination": "/now-lets-begin.html"
    },
    {
      "source": "/learn",
      "destination": "/share/learn.html"
    },
    {
      "source": "/guide",
      "destination": "/share/guide.html"
    },
    {
      "source": "/guide/library",
      "destination": "/share/guide-library.html"
    },
    {
      "source": "/give",
      "destination": "/share/give.html"
    },
    {
      "source": "/guide/teachback",
      "destination": "/share/teachback.html"
    },
    {
      "source": "/grow",
      "destination": "/share/grow.html"
    },
    {
      "source": "/waves",
      "destination": "/share/waves.html"
    },
    {
      "source": "/apply",
      "destination": "/share/apply.html"
    },
    {
      "source": "/guide/partners/green-reef/proposal",
      "destination": "/share/green-reef-proposal.html"
    },
    {
      "source": "/((?!media/|assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/media/wave-praxis.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"WAVE-PRAXIS.md\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://clerk.www.waves.fund https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.clerk.com; font-src 'self'; media-src 'self'; connect-src 'self' https://clerk.www.waves.fund; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
