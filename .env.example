# Copy to .env.local and fill in. Never commit real values.
# Production values are set in the Vercel project settings.

# Private Vercel Blob store for applications, receipts, votes and Trax analytics.
BLOB_READ_WRITE_TOKEN=

# Team sign-in key for /team/review and /trax. Rotating it signs the team out.
WAVES_ADMIN_KEY=

# Signing key for receipts, learner cookies and rate-limit hashes.
# Keep it stable: changing it breaks existing receipts and support records.
WAVES_DATA_KEY=

# Shared Wave workspaces. Both flags stay off until accounts are ready.
VITE_WORKSPACE_ENABLED=false
WAVES_WORKSPACE_ENABLED=false
WAVES_WORKSPACE_ADMIN_EMAILS=
WAVES_WORKSPACE_ORIGINS=

# Clerk accounts (workspaces only).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres (workspaces only).
DATABASE_URL=
